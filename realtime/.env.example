# Copy to realtime/.env.development for `npm run dev` (@colyseus/tools loads .env.<NODE_ENV>).
# Names only: never commit values. Production values live in Fly secrets (README "Deploy").

# development | test | production (Fly sets production in fly.toml)
NODE_ENV=
# Default 2567
PORT=

# Supabase project URL (https://<ref>.supabase.co). Required in production.
# Leave unset locally: the dev server never talks to the production database.
SUPABASE_URL=
# Supabase secret key, used only for the service-only calls (realtime_player_card, realtime_log_chat,
# realtime_sanctions_poll, world_blocks reads). Required in production.
SUPABASE_SECRET_KEY=

# Comma-separated exact origins. Default: the §1.4 production list.
ALLOWED_ORIGINS=
# Space-separated anchored regexes (^...$). Default: the uwotsi Vercel preview pattern.
ALLOWED_ORIGIN_PATTERNS=

# 1 accepts `dev:<name>` tokens (local only; refused when NODE_ENV=production)
DEV_AUTH=

# 32+ characters shared with the web app (Vercel REALTIME_INTERNAL_SECRET): signs POST /internal/sanction and
# /internal/block. Unset: those answer 503 and sanctions reach the island only through the 60 s poll.
REALTIME_INTERNAL_SECRET=
