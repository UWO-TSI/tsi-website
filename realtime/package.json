{
  "name": "tethos-realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Multiplayer server for the Tethos member island (Colyseus 0.18). Spec: specs/multiplayer.md.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=dist/index.mjs",
    "start": "node --enable-source-maps dist/index.mjs",
    "test": "vitest run --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "bots": "tsx scripts/bots.ts",
    "soak": "tsx test/soak.ts"
  },
  "dependencies": {
    "@colyseus/core": "~0.18.18",
    "@colyseus/schema": "^5.0.35",
    "@colyseus/tools": "~0.18.7",
    "@colyseus/ws-transport": "~0.18.4",
    "@supabase/supabase-js": "2.103.0",
    "colyseus": "~0.18.9",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@colyseus/sdk": "~0.18.4",
    "@colyseus/testing": "~0.18.6",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "~4.1.11"
  }
}
