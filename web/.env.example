# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin allowlist (comma-separated emails; union'd with the in-code baseline)
ADMIN_EMAIL_WHITELIST=

# Anthropic (LLM-driven NPC chat — server-only, never expose to client)
ANTHROPIC_API_KEY=

# Member world launch switch: "open" opens /student/dashboard, onboarding and the phone
# companion. Unset = open in local dev, closed in production. Inlined at build: redeploy after changing.
NEXT_PUBLIC_MEMBER_WORLD=
