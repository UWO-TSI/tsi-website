.DS_Store
*.json

# MCP config (contains API keys)
.cursor/mcp.json

# Environment files (API keys)
.env*
.env.local

# Un-ignore globe data files
!web/data/globe-nodes.json
!web/data/globe-countries.json

# The tile map IS the world. The blanket *.json above was silently keeping it
# out of every commit, so the grid island existed only on one machine.
!web/data/island-map.json

# Catalogue data that ships with the art and the sky textures
!art/characters/base/face_variants.json
!art/characters/base/ref18_measurements.json
!art/characters/hair/hair_catalog.json
!art/characters/character_catalog.json
!art/characters/palette.json
!web/public/assets/sky/layers/manifest.json
.vercel
*.jpeg
.playwright-mcp/
.next/
__pycache__/
.gstack/
