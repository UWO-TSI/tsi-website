.DS_Store
*.json

# MCP config (contains API keys)
.cursor/mcp.json

# Environment files (API keys)
.env*
.env.local

# Un-ignore globe data files
!web/data/globe-nodes.json
!web/data/globe-countries.json
!web/lib/recruitment-round-drafts.json

# The tile map IS the world. The blanket *.json above was silently keeping it
# out of every commit, so the grid island existed only on one machine.
!web/data/island-map.json
!web/data/characters/*.json

# The multiplayer server package (specs/multiplayer.md §1.1). Its manifests,
# tsconfig, env template and sanity fixtures must ship; real env files stay out.
!realtime/package.json
!realtime/package-lock.json
!realtime/tsconfig.json
!realtime/.env.example
!realtime/fixtures/**/*.json
realtime/dist/

# Catalogue data that ships with the art and the sky textures
!art/characters/base/face_variants.json
!art/characters/base/ref18_measurements.json
!art/characters/v7/face/face_v7.json
!art/characters/hair/hair_catalog.json
!art/characters/character_catalog.json
!art/characters/palette.json
!web/public/assets/sky/layers/manifest.json
# The Vanguard weapons' solved grips (art/props-enemies/solve_vanguard_grips.py): the wraps are built from them.
!art/props-enemies/vanguard_grips.json
.vercel
*.jpeg
.playwright-mcp/
.next/
__pycache__/
.gstack/
web/supabase/.temp/

# Root node_modules was tracked by accident until 2026-09-02; web/ owns its own deps
node_modules/
!art/characters/lod1/lod.json
