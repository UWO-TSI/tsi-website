.DS_Store
*.json

# MCP config (contains API keys)
.cursor/mcp.json

# Environment files (API keys)
.env*
.env.local

# Un-ignore globe data files
!web/data/globe-nodes.json
!web/data/globe-countries.json
!web/lib/recruitment-round-drafts.json

# The retired islands' maps (archive/village/README.md).
!archive/village/*.json
# The smooth world's document (specs/world-editor.md); its two PNGs sit beside it.
!web/data/world/world.json
# The server's cell view of it (catch checks), written with every save.
!web/data/world/cells.json
!web/data/characters/*.json

# The multiplayer server package (specs/multiplayer.md §1.1). Its manifests,
# tsconfig, env template and sanity fixtures must ship; real env files stay out.
!realtime/package.json
!realtime/package-lock.json
!realtime/tsconfig.json
!realtime/.env.example
!realtime/fixtures/**/*.json
realtime/dist/

# Catalogue data that ships with the art
!art/characters/base/face_variants.json
!art/characters/base/ref18_measurements.json
!art/characters/v7/face/face_v7.json
!art/characters/hair/hair_catalog.json
!art/characters/character_catalog.json
!art/characters/palette.json
# The Vanguard weapons' solved grips (art/props-enemies/solve_vanguard_grips.py): the wraps are built from them.
!art/props-enemies/vanguard_grips.json
!art/pipeline/concepts/**/*.blueprint.json
.vercel
*.jpeg
.playwright-mcp/
.next/
__pycache__/
.gstack/
web/supabase/.temp/

# Root node_modules was tracked by accident until 2026-09-02; web/ owns its own deps
node_modules/
!art/characters/lod1/lod.json
specs/tools/*/dist/

# Meshy output never ships raw (art/meshy/meshy.mjs)
art/meshy/raw/

# The tool pipeline's measured dimensions (art/pipeline/profile.py, art/pipeline/tools.md)
!art/pipeline/out/**/*.json

# Evidence composites that hold a third-party reference picture (never committed; the review page links the local file)
specs/evidence/**/*-vs-ref.*

# SFX library (game/sfx-library): downloads stay out of the repo; candidates are built from them
art/audio/staging/
specs/evidence/sfx-library/r1/*.ogg
specs/evidence/sfx-library/r2/*.ogg
specs/evidence/sfx-library/r3/*.ogg
!web/data/sfx-library.json
!web/data/talk-voices.json
specs/evidence/sfx-library/r4/
specs/evidence/sfx-library/r5/
art/audio/final/
